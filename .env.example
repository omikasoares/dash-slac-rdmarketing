# Porta local (em produção o Traefik cuida do roteamento externo)
PORT=3000

# App cadastrado na RD Station App Store (OAuth2)
RD_CLIENT_ID=
RD_CLIENT_SECRET=
# Gerado uma única vez com: npm run get-rd-tokens
RD_REFRESH_TOKEN=

# Segmentação padrão "Todos os contatos da base de Leads"
RD_SEGMENTATION_ID=15113383

# Intervalo do sync em segundo plano (minutos)
SYNC_INTERVAL_MINUTES=30

# Basic Auth do dashboard (exposto dados pessoais de leads)
DASHBOARD_USER=
DASHBOARD_PASSWORD=

# Secret aleatório e longo pra proteger a URL do webhook de nova conversão
# (gere com: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))")
WEBHOOK_SECRET=

# Onde o arquivo SQLite fica (em produção, aponte para o volume montado)
DB_PATH=./data/leads.db
