# RD Station Marketing (OAuth2 App Store) — usado só pro enriquecimento
# pontual via webhook de nova conversão (baixo volume). A sincronização em
# massa da base roda no n8n ("SLAC - Sync RD Station"), não neste app.
RD_CLIENT_ID=
RD_CLIENT_SECRET=
RD_REFRESH_TOKEN=
RD_REDIRECT_URI=http://127.0.0.1:4568

# Limitador de taxa proativo pras chamadas à API do RD feitas por este app
# (evita 429/backoff). Deixado moderado pra sobrar espaço pro n8n, que
# também chama a mesma conta RD Station (limite real da conta: 120/min).
RD_MAX_REQUESTS_PER_MINUTE=60

# Sync da planilha de CRM (intervalo fixo)
SHEET_SYNC_INTERVAL_MINUTES=15

# Dashboard (Basic Auth) — expõe dados pessoais de leads
DASHBOARD_USER=
DASHBOARD_PASSWORD=

# Webhook de "nova conversão" do RD Station
WEBHOOK_SECRET=

# Postgres — banco compartilhado "Postgres Autz" (mesmo usado pelo n8n).
# Em dev local, aponte pro container solto do README.
DATABASE_URL=postgres://dash:dash@localhost:5432/dash_slac

# Google Sheets (planilha de CRM/comercial)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
CRM_SHEET_ID=

PORT=3000
