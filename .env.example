# RD Station Marketing (OAuth2 App Store)
RD_CLIENT_ID=
RD_CLIENT_SECRET=
RD_REFRESH_TOKEN=
RD_REDIRECT_URI=http://127.0.0.1:4568
RD_SEGMENTATION_ID=15113383

# Limitador de taxa proativo pras chamadas à API do RD (evita 429/backoff)
RD_MAX_REQUESTS_PER_MINUTE=100

# Quantos contatos processar em paralelo na fase de detalhe do sync
SYNC_CONCURRENCY=15

# Scheduler do sync: intervalo curto em horário comercial, mais espaçado fora
# dele. Fuso America/Sao_Paulo (calculado via Intl, não depende de tzdata).
SYNC_BUSINESS_START=07:50
SYNC_BUSINESS_END=19:00
SYNC_INTERVAL_BUSINESS_MINUTES=5
SYNC_INTERVAL_OFFHOURS_MINUTES=60

# Sync da planilha de CRM (intervalo fixo, não depende de horário comercial)
SHEET_SYNC_INTERVAL_MINUTES=15

# Dashboard (Basic Auth) — expõe dados pessoais de leads
DASHBOARD_USER=
DASHBOARD_PASSWORD=

# Webhook de "nova conversão" do RD Station
WEBHOOK_SECRET=

# Postgres — em dev local, aponte pro container solto do README; em produção
# (Portainer), o stack.yml monta essa URL sozinho a partir de POSTGRES_*.
DATABASE_URL=postgres://dash:dash@localhost:5432/dash_slac
POSTGRES_USER=dash
POSTGRES_PASSWORD=dash
POSTGRES_DB=dash_slac

# Google Sheets (planilha de CRM/comercial)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
CRM_SHEET_ID=

PORT=3000
