# Dashboard (Basic Auth) — expõe dados pessoais de leads
DASHBOARD_USER=
DASHBOARD_PASSWORD=

PORT=3000

# Nada de RD Station / Postgres / Google Sheets aqui — esse app só serve o
# front estático. Sync e enriquecimento rodam nos workflows do n8n
# ("SLAC - Sync RD Station", "SLAC - Sync Planilha CRM",
